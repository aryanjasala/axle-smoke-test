{
  "$comment": "Screens tests/e2e/a11y.spec.js checks with axe-core. This file belongs to the plugin: apply-template.py only writes it when it is missing. The fields are described in docs/DEVELOPMENT.md.",
  "include": [
    "#wpbody-content"
  ],
  "exclude": [
    ".ast-frame"
  ],
  "screens": [
    {
      "name": "Tools > Smoke Test, first visit: empty list and the Get started card",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        },
        {
          "js": "seed.js",
          "call": "resetRuns"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test",
      "steps": [
        {
          "waitFor": ".axle-empty"
        },
        {
          "waitFor": ".ast-steps"
        }
      ]
    },
    {
      "name": "Runs list with the latest run",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test",
      "steps": [
        {
          "waitFor": ".ast-runs"
        }
      ]
    },
    {
      "name": "A red run with the rollback offer",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&run={seeded.red}",
      "steps": [
        {
          "waitFor": ".ast-problems"
        }
      ]
    },
    {
      "name": "An amber run with a JavaScript error",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&run={seeded.amber}",
      "steps": [
        {
          "waitFor": ".ast-results"
        }
      ]
    },
    {
      "name": "A green run",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&run={seeded.green}",
      "steps": [
        {
          "waitFor": ".ast-results"
        }
      ]
    },
    {
      "name": "Settings",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&tab=settings",
      "steps": [
        {
          "waitFor": ".ast-settings"
        }
      ]
    },
    {
      "name": "Settings with checks as a role switched on",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        },
        {
          "wp": [
            "axle-smoke-test",
            "role-checks",
            "on",
            "--role=editor"
          ]
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&tab=settings",
      "steps": [
        {
          "waitFor": "#ast-roles"
        }
      ],
      "cleanup": [
        {
          "wp": [
            "axle-smoke-test",
            "role-checks",
            "off"
          ]
        }
      ]
    },
    {
      "name": "Checking your site panel with its verdict",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        },
        {
          "js": "seed.js",
          "call": "waitingRun"
        }
      ],
      "url": "/wp-admin/plugins.php",
      "include": [
        ".ast-panel"
      ],
      "steps": [
        {
          "waitFor": ".ast-panel[data-verdict]"
        }
      ]
    },
    {
      "name": "Notice about a failed run",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        },
        {
          "js": "seed.js",
          "call": "showNotice",
          "args": [
            "{seeded.red}"
          ]
        }
      ],
      "url": "/wp-admin/index.php",
      "include": [
        ".ast-alert-notice"
      ]
    },
    {
      "name": "A red run with a missing form: accept this change asks first",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&run={seeded.red}",
      "steps": [
        {
          "waitFor": ".ast-reason .ast-accept"
        },
        {
          "click": ".ast-reason .ast-accept"
        },
        {
          "waitFor": ".ast-reason .axle-confirm"
        }
      ]
    },
    {
      "name": "A red run: roll back asks first",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&run={seeded.red}",
      "steps": [
        {
          "waitFor": ".ast-problems .ast-rollback"
        },
        {
          "click": ".ast-problems .ast-rollback"
        },
        {
          "waitFor": ".ast-problems .axle-confirm"
        }
      ]
    },
    {
      "name": "An amber run: accept the baseline asks first",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens",
          "save": "seeded"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&run={seeded.amber}",
      "steps": [
        {
          "click": ".axle-actions .ast-confirm summary"
        },
        {
          "waitFor": ".axle-actions .axle-confirm"
        }
      ]
    },
    {
      "name": "Runs list filtered by verdict",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&verdict=red",
      "steps": [
        {
          "waitFor": ".ast-runs"
        }
      ]
    },
    {
      "name": "Settings with suggested pages",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        },
        {
          "wp": [
            "option",
            "update",
            "ast_fixture_languages",
            "1"
          ]
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&tab=settings",
      "steps": [
        {
          "waitFor": "#ast-suggestions"
        }
      ],
      "cleanup": [
        {
          "wp": [
            "option",
            "delete",
            "ast_fixture_languages"
          ]
        }
      ]
    },
    {
      "name": "Settings with the rules of a URL open",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&tab=settings",
      "steps": [
        {
          "click": ".ast-urls .ast-rules summary"
        },
        {
          "waitFor": ".ast-rules-form"
        }
      ]
    },
    {
      "name": "Settings: removing a URL asks first",
      "setup": [
        {
          "js": "seed.js",
          "call": "seedScreens"
        },
        {
          "wp": [
            "axle-smoke-test",
            "urls",
            "add",
            "/old-landing/",
            "--label=Old landing"
          ]
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-smoke-test&tab=settings",
      "steps": [
        {
          "click": ".ast-urls .ast-confirm summary"
        },
        {
          "waitFor": ".ast-urls .axle-confirm"
        }
      ]
    }
  ],
  "skip": {}
}
